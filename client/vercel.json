{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "redirects": [
    { "source": "/brands/other", "destination": "/brands/asustor", "permanent": true },
    { "source": "/tools/calculator", "destination": "/finder#roi", "statusCode": 301 },
    { "source": "/tools/calculator/", "destination": "/finder#roi", "statusCode": 301 }
  ],
  "rewrites": [{ "source": "/((?!api/|assets/).*)", "destination": "/app.html" }]
}
