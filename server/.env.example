# PostgreSQL connection string. On Railway, reference the Postgres service:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# Leave unset locally to use the in-memory store.
DATABASE_URL=
PORT=4000
# Comma-separated allowed origins, e.g. https://nas-town.vercel.app (defaults to allow all)
CORS_ORIGIN=
# Signs staff sessions. Required in production: a long random string.
AUTH_SECRET=
# First admin account, created on start when no admin exists yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Lead emails (server/src/mailer.js), sent through Resend: https://resend.com
# Without RESEND_API_KEY no email is sent (leads are still saved).
RESEND_API_KEY=
# Sender on a domain verified in Resend (Domains → Add nastown.com, then add its DNS records).
MAIL_FROM=NASTOWN <quotes@nastown.com>
# Where customers' replies go (optional).
MAIL_REPLY_TO=
# Who is alerted about every new lead (comma-separated).
LEAD_NOTIFY_TO=bhavya.digibuggy@gmail.com
# Public site address, used for links in emails.
SITE_URL=https://nastown.com
